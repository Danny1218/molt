{
  "name": "molt",
  "version": "1.0.0",
  "description": "Browser automations that repair themselves when websites change",
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "vite",
    "build": "vite build && tsc --project tsconfig.server.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "portal-only": "tsx src/server.ts --portal-only"
  },
  "keywords": ["kane", "automation", "self-repair", "testing"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.5",
    "@types/ws": "^8.5.10",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vitest": "^1.2.1"
  }
}
